+/* The HD pack's drawing scale for this machine's largest display: the scale
+ * whose picture (240 lines high) covers the display's height in pixels, so a
+ * full-screen picture is never enlarged, and nothing more is composed and
+ * uploaded every frame than the display can show (a 10x pack on a 1600-line
+ * screen: 7x, half the pixels). 0 = the pack's own (macOS, where the display
+ * size before a window exists is in points, not pixels). */
+int cyc_sdl_hd_scale_hint(void)
+{
+#ifdef __APPLE__
+    return 0;
+#else
+    if (SDL_InitSubSystem(SDL_INIT_VIDEO) != 0) return 0;
+    int best = 0;
+    for (int i = 0; i < SDL_GetNumVideoDisplays(); ++i) {
+        SDL_DisplayMode m;
+        if (SDL_GetDesktopDisplayMode(i, &m) != 0) continue;
+        double px = m.h;
+#ifdef _WIN32
+        float ddpi = 0;
+        if (SDL_GetDisplayDPI(i, &ddpi, NULL, NULL) == 0 && ddpi > 96.0f) px *= ddpi / 96.0f;   /* (scaled desktop) */
+#endif
+        int sc = (int)ceil(px / 240.0 - 0.02);
+        if (sc > best) best = sc;
+    }
+    SDL_QuitSubSystem(SDL_INIT_VIDEO);
+    return best < 2 ? 0 : best;
+#endif
+}
