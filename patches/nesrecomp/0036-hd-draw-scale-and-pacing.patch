+/* Scale a premultiplied ARGB picture by num/den (den > num) with an area
+ * filter: each output pixel is the average of the input area it covers. */
+static uint32_t *area_downscale(const uint32_t *px, int w, int h, int num, int den, int *ow, int *oh) {
+    int nw = (int)((long)w * num / den), nh = (int)((long)h * num / den);
+    if (nw < 1) nw = 1;
+    if (nh < 1) nh = 1;
+    float *tmp = (float *)malloc((size_t)nw * h * 4 * sizeof(float));
+    uint32_t *out = (uint32_t *)malloc((size_t)nw * nh * sizeof(uint32_t));
+    if (!tmp || !out) { free(tmp); free(out); return NULL; }
+    const double fx = (double)w / nw, fy = (double)h / nh;
+    for (int y = 0; y < h; y++) {                       /* across */
+        const uint32_t *row = px + (size_t)y * w;
+        for (int x = 0; x < nw; x++) {
+            double a0 = x * fx, a1 = a0 + fx, acc[4] = {0, 0, 0, 0};
+            for (int i = (int)a0; i < w && i < a1; i++) {
+                double wgt = (i + 1 < a1 ? i + 1 : a1) - (i > a0 ? i : a0);
+                uint32_t v = row[i];
+                acc[0] += wgt * (v >> 24); acc[1] += wgt * ((v >> 16) & 255);
+                acc[2] += wgt * ((v >> 8) & 255); acc[3] += wgt * (v & 255);
+            }
+            float *t = tmp + ((size_t)y * nw + x) * 4;
+            for (int c = 0; c < 4; c++) t[c] = (float)(acc[c] / fx);
+        }
+    }
+    for (int x = 0; x < nw; x++) {                      /* down */
+        for (int y = 0; y < nh; y++) {
+            double a0 = y * fy, a1 = a0 + fy, acc[4] = {0, 0, 0, 0};
+            for (int i = (int)a0; i < h && i < a1; i++) {
+                double wgt = (i + 1 < a1 ? i + 1 : a1) - (i > a0 ? i : a0);
+                const float *t = tmp + ((size_t)i * nw + x) * 4;
+                for (int c = 0; c < 4; c++) acc[c] += wgt * t[c];
+            }
+            int ch[4];
+            for (int c = 0; c < 4; c++) { int v = (int)(acc[c] / fy + 0.5); ch[c] = v < 0 ? 0 : v > 255 ? 255 : v; }
+            for (int c = 1; c < 4; c++) if (ch[c] > ch[0]) ch[c] = ch[0];   /* stay premultiplied */
+            out[(size_t)y * nw + x] = ((uint32_t)ch[0] << 24) | ((uint32_t)ch[1] << 16) | ((uint32_t)ch[2] << 8) | (uint32_t)ch[3];
+        }
+    }
+    free(tmp);
+    *ow = nw; *oh = nh;
+    return out;
+}
+
+/* A loaded picture at the drawing scale (frees the original when scaled). */
+static uint32_t *to_draw_scale(uint32_t *px, int *w, int *h) {
+    if (s_scale >= s_pack_scale || !px) return px;
+    int nw, nh;
+    uint32_t *d = area_downscale(px, *w, *h, s_scale, s_pack_scale, &nw, &nh);
+    if (!d) return px;
+    free(px); *w = nw; *h = nh;
+    return d;
+}
+
+void hdpack_set_draw_scale(int scale) {
+    const char *e = getenv("NESRECOMP_HD_SCALE");     /* (overrides the host's choice) */
+    if (e && atoi(e) > 0) scale = atoi(e);
+    s_draw_req = scale < 0 ? 0 : scale;
+}
