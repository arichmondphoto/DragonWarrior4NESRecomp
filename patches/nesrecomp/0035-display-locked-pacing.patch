+/* ---- display-locked pacing ----
+ * With VSync on, the guest's own 60.0988 Hz deadline and the display's
+ * blocking present are two clocks: the deadline drifts across the refresh, so
+ * on a heavy frame (HD) the picture misses its refresh, the next present
+ * waits a whole refresh more, the guest falls a frame behind and that frame
+ * is never shown: an uneven, shuddering scroll. When the display runs at a
+ * whole multiple of the guest's rate (60, 120, 240 Hz, within 2%), the
+ * display paces instead: one guest frame per N refreshes, each refresh
+ * presented (the same picture again for the others), no deadline wait. The
+ * game then runs at the display's rate (60 Hz: 0.16% slower than an NES,
+ * which nobody hears: the audio is stretched to match, below). Other rates
+ * (75, 144 Hz) keep the deadline. A driver whose present does not wait
+ * (hidden window, VSync refused) is noticed and pacing falls back.
+ * NESRECOMP_PACING=deadline turns it off (=display: on, and a display that
+ * reports no rate is taken as 60 Hz); NESRECOMP_PACING_LOG=1 prints the
+ * pacing every 5 s (stderr). */
+static int  s_lock_n;            /* refreshes per guest frame (0: deadline) */
+static int  s_lock_hz;
+static bool s_lock_off;          /* the present does not wait here: deadline from now on */
+
+static int display_refresh(void)
+{
+    SDL_DisplayMode m;
+    int i = SDL_GetWindowDisplayIndex(s_win);
+    if (i >= 0 && SDL_GetCurrentDisplayMode(i, &m) == 0 && m.refresh_rate > 0) return m.refresh_rate;
+    return 0;
+}
+
+static void lock_update(double guest_hz)
+{
+    static int env = -1;            /* 1 deadline, 2 display (a display that reports no rate: 60 Hz) */
+    if (env < 0) {
+        const char *e = getenv("NESRECOMP_PACING");
+        env = !e ? 0 : !strcmp(e, "deadline") ? 1 : !strcmp(e, "display") ? 2 : 0;
+    }
+    s_lock_n = 0;
+    s_lock_hz = display_refresh();
+    if (s_lock_hz <= 0 && env == 2) s_lock_hz = 60;
+    if (env == 1 || s_lock_off || s_lock_hz <= 0) return;
+    double r = s_lock_hz / guest_hz;
+    int n = (int)(r + 0.5);
+    if (n >= 1 && n <= 4 && fabs(r - n) <= 0.02 * n) s_lock_n = n;
+}
+
+/* Audio made at the display's pace instead of the NES's is stretched by up to
+ * 0.5% to keep the queue near its target: linear interpolation, carried from
+ * one block to the next. */
+static size_t audio_stretch(const int16_t *in, size_t n, double f, int16_t *out, size_t cap)
+{
+    static int16_t last;
+    static double pos = -1.0;        /* in input samples; -1 = `last` */
+    size_t m = 0;
+    if (!n) return 0;
+    double step = 1.0 / f;
+    if (pos < -1.0) pos = -1.0;
+    while (pos <= (double)(n - 1) && m < cap) {
+        int i = (int)floor(pos);
+        double t = pos - i;
+        double a = i < 0 ? last : in[i], b = i + 1 < (int)n ? in[i + 1] : in[n - 1];
+        out[m++] = (int16_t)lrint(a + (b - a) * t);
+        pos += step;
+    }
+    pos -= (double)n;
+    last = in[n - 1];
+    return m;
+}
