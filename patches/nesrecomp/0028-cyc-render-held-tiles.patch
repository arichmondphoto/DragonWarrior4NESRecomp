diff --git a/runner/cyc/cyc_render.c b/runner/cyc/cyc_render.c
index 98775e8..b1258c1 100644
--- a/runner/cyc/cyc_render.c
+++ b/runner/cyc/cyc_render.c
@@ -19,6 +19,30 @@ typedef struct { uint16_t pattern; int8_t pal; uint8_t oxy; } HdCell;
 static HdCell          s_hd[CYC_VIDEO_MAX_WIDTH * 240], s_hd_sp[CYC_VIDEO_MAX_WIDTH * 240];
 static int             s_hd_width;
 static bool            s_painted;
+/* CHR bytes a compositor gave for pattern addresses (cyc_render_hd_chr). */
+static uint16_t        s_chr_pattern[512];
+static uint8_t         s_chr_bytes[512][16];
+static int             s_chr_count;
+
+void cyc_render_hd_chr(uint16_t pattern, const uint8_t bytes[16])
+{
+    for (int i = 0; i < s_chr_count; ++i)
+        if (s_chr_pattern[i] == pattern) { memcpy(s_chr_bytes[i], bytes, 16); return; }
+    if (s_chr_count >= 512) return;
+    s_chr_pattern[s_chr_count] = pattern; memcpy(s_chr_bytes[s_chr_count++], bytes, 16);
+}
+
+const uint8_t *cyc_render_hd_chr_bytes(uint16_t pattern)
+{
+    for (int i = 0; i < s_chr_count; ++i)
+        if (s_chr_pattern[i] == pattern) return s_chr_bytes[i];
+    return NULL;
+}
+
+uint32_t cyc_render_nes_color(uint8_t value, uint8_t mask)
+{
+    return hw_palette_argb[((mask & 1) ? (value & 0x30) : (value & 0x3F)) | (unsigned)(mask >> 5) << 6];
+}
 
