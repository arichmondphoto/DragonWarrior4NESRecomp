+static void menu_nav_axis(const SDL_ControllerAxisEvent *a)
+{
+#ifdef CYC_WITH_RECOMP_UI
+    static int held[2];                       /* per axis: -1, 0, +1 */
+    int axis = a->axis == SDL_CONTROLLER_AXIS_LEFTX ? 0 : a->axis == SDL_CONTROLLER_AXIS_LEFTY ? 1 : -1;
+    if (axis < 0) return;
+    int dir = a->value > 16000 ? 1 : a->value < -16000 ? -1 : 0;
+    if (abs(a->value) > 8000 && held[axis] && dir == 0) return;   /* between: keep the state */
+    if (dir == held[axis]) return;
+    held[axis] = dir;
+    if (!dir) return;
+    cyc_ui_nav(axis == 0 ? (dir < 0 ? RECOMP_RUNTIME_UI_INPUT_LEFT : RECOMP_RUNTIME_UI_INPUT_RIGHT)
+                         : (dir < 0 ? RECOMP_RUNTIME_UI_INPUT_UP : RECOMP_RUNTIME_UI_INPUT_DOWN), false);
+#else
+    (void)a;
