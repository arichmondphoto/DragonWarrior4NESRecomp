diff --git a/runner/cyc/cyc_hdpack_state.inc b/runner/cyc/cyc_hdpack_state.inc
index 0eda38e..4799e80 100644
--- a/runner/cyc/cyc_hdpack_state.inc
+++ b/runner/cyc/cyc_hdpack_state.inc
@@ -56,12 +56,19 @@ static bool valid_pixel(const HdRecordedPixel *p) {
     for(unsigned j=0;j<3;j++)if(p->sp_pal[j]>63)return false;
     return true;
 }
+static bool same_pack(const HdStateHeader *h) {
+    return h->active==(unsigned)(hdpack_active()!=0) && h->scale==(unsigned)hdpack_scale() && !memcmp(h->fingerprint,fingerprint,sizeof fingerprint);
+}
 static int validate_part(unsigned part,const uint8_t *buf,int len) {
     size_t size=part==4?sizeof pipeline:sizeof(recorded)/4;
     if(!buf || len<(int)sizeof(HdStateHeader))return 0;
     HdStateHeader h;memcpy(&h,buf,sizeof h);
     bool compact=h.version==3;
-    if((h.version!=2 && !compact) || h.part!=part || h.active!=(unsigned)(hdpack_active()!=0) || h.scale!=(unsigned)hdpack_scale() || memcmp(h.fingerprint,fingerprint,sizeof fingerprint))return 0;
+    if((h.version!=2 && !compact) || h.part!=part)return 0;
+    /* Saved with the HD pack off, another pack or another version of it: the
+     * record only holds the picture being drawn, which the next frame
+     * redraws, so the state still loads (load_part drops the record). */
+    if(!same_pack(&h))return compact ? len==(int)sizeof h : len==(int)(sizeof h+size);
     if(compact)return !h.active && len==(int)sizeof h;
     if(len!=(int)(sizeof h+size))return 0;
     if(part==4) {
@@ -80,6 +87,6 @@ static int load_part(unsigned part,const uint8_t *buf,int len) {
     size_t size=part==4?sizeof pipeline:sizeof(recorded)/4;
     void *payload=part==4?(void *)&pipeline:(void *)&recorded[part*256*60];
     HdStateHeader h;memcpy(&h,buf,sizeof h);
-    if(h.version==3)memset(payload,0,size);else memcpy(payload,buf+sizeof h,size);
+    if(h.version==3 || !same_pack(&h))memset(payload,0,size);else memcpy(payload,buf+sizeof h,size);
     presentation_valid=false;return 1;
 }
