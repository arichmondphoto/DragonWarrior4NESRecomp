diff --git a/runner/cyc/cyc_cheats.c b/runner/cyc/cyc_cheats.c
new file mode 100644
index 0000000..c31cb43
--- /dev/null
+++ b/runner/cyc/cyc_cheats.c
@@ -0,0 +1,95 @@
+/* Game Genie codes: see cyc_cheats.h. */
+#include "cyc_cheats.h"
+#include "cyc_mod.h"
+#include "cyc_recomp.h"
+#include "hw_internal.h"
+#include <ctype.h>
+#include <stdio.h>
+#include <string.h>
+
+extern bool cyc_run_native;
+
+static int gg_letter(char c)
+{
+    static const char L[] = "APZLGITYEOXUKSVN";
+    const char *p = strchr(L, toupper((unsigned char)c));
+    return c && p ? (int)(p - L) : -1;
+}
+
+bool cyc_gg_decode(const char *code, uint16_t *addr, uint8_t *value, bool *has_compare, uint8_t *compare)
+{
+    size_t len = code ? strlen(code) : 0;
+    if (len != 6 && len != 8) return false;
+    int n[8];
+    for (size_t i = 0; i < len; i++) if ((n[i] = gg_letter(code[i])) < 0) return false;
+    *addr = (uint16_t)(0x8000 | ((n[3] & 7) << 12) | ((n[5] & 7) << 8) | ((n[4] & 8) << 8) |
+                       ((n[2] & 7) << 4) | ((n[1] & 8) << 4) | (n[4] & 7) | (n[3] & 8));
+    if (len == 6) {
+        *value = (uint8_t)(((n[1] & 7) << 4) | ((n[0] & 8) << 4) | (n[0] & 7) | (n[5] & 8));
+        *has_compare = false; *compare = 0;
+    } else {
+        *value = (uint8_t)(((n[1] & 7) << 4) | ((n[0] & 8) << 4) | (n[0] & 7) | (n[7] & 8));
+        *compare = (uint8_t)(((n[7] & 7) << 4) | ((n[6] & 8) << 4) | (n[6] & 7) | (n[5] & 8));
+        *has_compare = true;
+    }
+    return true;
+}
+
+/* Can a byte at CPU address addr be one the native code folded? Any PRG byte
+ * that some bank arrangement maps there (same offset within a 4 KiB page) and,
+ * for a compare code, that holds the compare value. */
+static bool touches_native_code(uint16_t addr, bool has_compare, uint8_t compare)
+{
+    if (!hw_cart.prg) return true;
+    for (uint32_t off = addr & 0x0FFFu; off < hw_cart.prg_len; off += 0x1000u) {
+        if (has_compare && hw_cart.prg[off] != compare) continue;
+        if (cyc_native_prg_code_byte(off)) return true;
+    }
+    return false;
+}
+
+static bool s_forced_interp;     /* this module turned native code off */
+
+int cyc_cheats_apply_file(const char *path)
+{
+    cyc_mod_clear_rom_read_overrides();
+    if (s_forced_interp) { cyc_run_native = true; s_forced_interp = false; }
+    if (!path || !*path) return 0;
+    FILE *f = fopen(path, "r");
+    if (!f) return 0;
+    char line[512];
+    int applied = 0, code_bytes = 0;
+    while (fgets(line, sizeof line, f)) {
+        char *hash = strchr(line, '#'); if (hash) *hash = 0;
+        char a[32] = "", b[32] = "";
+        int k = sscanf(line, "%31s %31s", a, b);
+        if (k < 1) continue;
+        const char *code = a; bool on = true;
+        if (!strcmp(a, "on") || !strcmp(a, "off") || !strcmp(a, "ON") || !strcmp(a, "OFF")) {
+            if (k < 2) continue;
+            on = toupper((unsigned char)a[1]) == 'N'; code = b;
+        }
+        if (!on) continue;
+        uint16_t addr; uint8_t value, compare; bool has_compare;
+        if (!cyc_gg_decode(code, &addr, &value, &has_compare, &compare)) {
+            fprintf(stderr, "[cheats] ignoring '%s': not a Game Genie code\n", code);
+            continue;
+        }
+        bool ok = has_compare ? cyc_mod_set_rom_read_override_cmp(addr, compare, value)
+                              : cyc_mod_set_rom_read_override(addr, value);
+        if (!ok) { fprintf(stderr, "[cheats] '%s': too many codes\n", code); continue; }
+        bool native = touches_native_code(addr, has_compare, compare);
+        code_bytes += native;
+        if (has_compare)
+            fprintf(stderr, "[cheats] %s: $%04X = %02X if %02X%s\n", code, addr, value, compare, native ? " (game code)" : "");
+        else
+            fprintf(stderr, "[cheats] %s: $%04X = %02X%s\n", code, addr, value, native ? " (game code)" : "");
+        applied++;
+    }
+    fclose(f);
+    if (code_bytes && cyc_run_native) {
+        cyc_run_native = false; s_forced_interp = true;
+        fprintf(stderr, "[cheats] %d code(s) change game code: running on the interpreter\n", code_bytes);
+    }
+    return applied;
+}
diff --git a/runner/cyc/cyc_cheats.h b/runner/cyc/cyc_cheats.h
new file mode 100644
index 0000000..65ecb56
--- /dev/null
+++ b/runner/cyc/cyc_cheats.h
@@ -0,0 +1,36 @@
+/* Game Genie codes (cheats.txt), applied through the ROM read overrides of
+ * cyc_mod.h.
+ *
+ * cheats.txt, one code per line ('#' starts a comment):
+ *     on  NNSOAPZU  Start with 255 gold
+ *     off AEEGKLAP  No status window when stopping
+ * "on"/"off", the 6- or 8-letter code, then an optional name. A line with only
+ * a code is on. The launcher's Cheats page writes this file.
+ *
+ * A 6-letter code substitutes the byte read at its address, an 8-letter code
+ * only when the cartridge byte there is its compare value (any bank mapped at
+ * the address, as the real device did). A code whose address can hold a byte
+ * the recompiler turned into C (an opcode, an address operand) cannot work
+ * through the native code, so then the game runs on the interpreter (which
+ * reads every byte at run time) for the session. */
+#ifndef CYC_CHEATS_H
+#define CYC_CHEATS_H
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Decode a 6- or 8-letter code (letters APZLGITYEOXUKSVN, any case).
+ * Returns false when it is not a valid code. */
+bool cyc_gg_decode(const char *code, uint16_t *addr, uint8_t *value, bool *has_compare, uint8_t *compare);
+
+/* Read path and apply its enabled codes (after the cartridge is loaded).
+ * Returns how many codes were applied; a missing file applies none. */
+int cyc_cheats_apply_file(const char *path);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
