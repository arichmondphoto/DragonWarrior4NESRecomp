-    read_overrides[read_override_count].qualified = 0;
     read_override_count++;
     cyc_mod_rom_read_overrides = read_overrides;
     return true;
@@ -68,6 +68,21 @@ bool cyc_mod_set_prg_read_override(uint32_t offset, uint8_t compare, uint8_t val
     return true;
 }
 
+bool cyc_mod_set_rom_read_override_cmp(uint16_t addr, uint8_t compare, uint8_t value)
+{
+    if (addr < 0x8000) return false;
+    for (unsigned i = 0; i < read_override_count; i++) {
+        CycModReadOverride *e = &read_overrides[i];
+        if (!e->qualified && e->by_compare && e->addr == addr && e->compare == compare) { e->value = value; return true; }
+    }
+    if (read_override_count >= CYC_MOD_READ_OVERRIDES_MAX) return false;
+    CycModReadOverride *entry = &read_overrides[read_override_count++];
+    memset(entry, 0, sizeof *entry);
+    entry->addr = addr; entry->compare = compare; entry->by_compare = 1; entry->value = value;
+    cyc_mod_rom_read_overrides = read_overrides;
+    return true;
+}
+
 void cyc_mod_clear_rom_read_overrides(void)
 {
     read_override_count = 0;
