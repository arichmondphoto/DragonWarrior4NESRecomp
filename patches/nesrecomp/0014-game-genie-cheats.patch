+    snprintf(out, n, "%s", s_set_path[0] ? s_set_path : cyc_settings_default_path());
+    char *cut = strrchr(out, '/'), *bcut = strrchr(out, '\\');
+    if (bcut > cut) cut = bcut;
+    if (cut) snprintf(cut + 1, n - (size_t)(cut + 1 - out), "cheats.txt");
+    else snprintf(out, n, "cheats.txt");
+    return out[0] != 0;
