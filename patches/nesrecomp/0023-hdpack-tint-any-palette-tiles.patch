+/* the most used non-zero colour index (1-3) of an 8x8 tile; 0 for a blank tile */
+static unsigned main_index(const uint8_t *t) {
+    unsigned n[4]={0,0,0,0};
+    for(int y=0;y<8;y++){
+        uint8_t lo=t[y],hi=t[y+8];
+        n[1]+=(unsigned)__builtin_popcount(lo&~hi&0xFF);
+        n[2]+=(unsigned)__builtin_popcount(hi&~lo&0xFF);
+        n[3]+=(unsigned)__builtin_popcount(lo&hi);
+    }
+    unsigned k=0,best=0;
+    for(unsigned i=1;i<4;i++)if(n[i]>best){best=n[i];k=i;}
+    return k;
+}
