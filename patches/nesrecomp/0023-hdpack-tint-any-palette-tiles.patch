+/* A tile matched only through its defaultTile=Y (any-palette) entry, drawn in
+ * the NES colour the game gives it (HdPixel.bg_tint/sp_tint): the art is
+ * white, so each channel is scaled by the colour (rgbd: with no offset).
+ * Thread-local scratch: one per compositing thread. */
+static const HdTile *tinted(const HdTile *t, uint32_t argb) {
+    static _Thread_local HdTile tmp;
+    tmp = *t;
+    tmp.has_drgb = 1;
+    tmp.dg[0] = (float)((argb >> 16) & 0xFF) / 255.0f;
+    tmp.dg[1] = (float)((argb >> 8) & 0xFF) / 255.0f;
+    tmp.dg[2] = (float)(argb & 0xFF) / 255.0f;
+    tmp.dofs[0] = tmp.dofs[1] = tmp.dofs[2] = 0;
+    return &tmp;
+}
