+typedef struct { uint16_t pattern; int8_t pal; uint8_t oxy; } HdCell;
+static HdCell          s_hd[CYC_VIDEO_MAX_WIDTH * 240];
+static int             s_hd_width;
+static bool            s_painted;
+
+void cyc_render_hd_tile(int x, int y, uint16_t pattern, int palette)
+{
+    for (int r = 0; r < 8; ++r) {
+        int py = y + r;
+        if (py < 0 || py >= 240) continue;
+        for (int c = 0; c < 8; ++c) {
+            int px = x + c;
+            if (px < 0 || px >= s_hd_width) continue;
+            HdCell *h = &s_hd[py * s_hd_width + px];
+            h->pattern = pattern; h->pal = (int8_t)(palette & 3); h->oxy = (uint8_t)(c | r << 4);
+        }
+    }
+}
+
+bool cyc_render_hd_cell(int x, int y, uint16_t *pattern, int *palette, int *ox, int *oy)
+{
+    if (x < 0 || y < 0 || x >= s_hd_width || y >= 240) return false;
+    const HdCell *h = &s_hd[y * s_hd_width + x];
+    if (h->pal < 0) return false;
+    *pattern = h->pattern; *palette = h->pal; *ox = h->oxy & 15; *oy = h->oxy >> 4;
+    return true;
+}
+
+bool cyc_render_composed(int *origin)
+{
+    if (origin) *origin = s_origin;
+    return s_painted;
+}
 
