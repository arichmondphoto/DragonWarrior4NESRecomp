diff --git a/runner/cyc/cyc_host.c b/runner/cyc/cyc_host.c
index 2a2427f..487e60b 100644
--- a/runner/cyc/cyc_host.c
+++ b/runner/cyc/cyc_host.c
@@ -137,6 +137,8 @@
  *   Packaged apps (environment):
  *     NESRECOMP_SAVE_NAME  the battery save's and save states' file name stem,
  *                          instead of the ROM file's
+ *     NESRECOMP_DATA_DIR   the folder for config.ini, mods/, saves/, rom.cfg and
+ *                          cheats.txt (default: beside the program)
  *     NESRECOMP_STATE_DIR  the folder for save-state slots (default
  *                          <SDL base dir>/saves, inside a macOS app bundle)
  *   A game's own options (cyc_host_extras.h) follow its --help lines.
diff --git a/runner/cyc/cyc_settings.c b/runner/cyc/cyc_settings.c
index 970afb4..d013558 100644
