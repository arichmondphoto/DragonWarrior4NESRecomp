+++ b/runner/cyc/cyc_settings.c
@@ -38,6 +38,10 @@ const char *cyc_settings_default_path(void)
 {
     static char path[1024];
     char dir[900] = ".";
+    /* A packaged app whose program folder is read-only (an AppImage) keeps
+     * config.ini, mods/, saves/, rom.cfg and cheats.txt in a data folder. */
+    const char *data = getenv("NESRECOMP_DATA_DIR");
+    if (data && *data) { snprintf(path, sizeof(path), "%s/config.ini", data); return path; }
 #ifdef _WIN32
     DWORD n = GetModuleFileNameA(NULL, dir, sizeof(dir));
     if (n == 0 || n >= sizeof(dir)) strcpy(dir, ".");
