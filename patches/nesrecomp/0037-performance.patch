+        s_blocked_len = chunks;
+    }
+    size_t c = offset >> 10;                 /* = bank4 * 4 + chunk in the 4 KB page */
+    if (c < s_blocked_len) cyc_native_blocked[c] = 1;
+    if ((offset & 0x3FF) < 2 && c > 0) cyc_native_blocked[c - 1] = 1;
+}
+
+void cyc_native_unblock_all(void) {
+    free(cyc_native_blocked); cyc_native_blocked = NULL; s_blocked_len = 0;
+}
