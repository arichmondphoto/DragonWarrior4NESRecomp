+/* Run the 1 KB chunk of compiled code holding a changed PRG byte on the
+ * interpreter (and the chunk before, for an instruction that starts there
+ * and reaches into it); the rest of the program stays compiled. */
+void cyc_native_block_prg(uint32_t offset) {
+    size_t chunks = (size_t)(hw_cart.prg_len / 0x1000u + 1) * 4;
+    if (!cyc_native_blocked) {
+        cyc_native_blocked = (uint8_t *)calloc(chunks, 1);
