@@ -1366,7 +1366,7 @@ draw:
  * uploaded every frame than the display can show (a 10x pack on a 1600-line
  * screen: 7x, half the pixels). 0 = the pack's own (macOS, where the display
  * size before a window exists is in points, not pixels). */
-int cyc_sdl_hd_scale_hint(void)
+static int display_hd_scale(void)
 {
 #ifdef __APPLE__
     return 0;
@@ -1389,6 +1389,22 @@ int cyc_sdl_hd_scale_hint(void)
 #endif
 }
 
+/* The launcher's HD detail (config.ini [Display] HDDetail): Auto = the
+ * display's scale above; Full = the pack's own; Balanced = 3/4 of Auto; Fast
+ * = half of it (never under 3x). 0 = the pack's own. */
+int cyc_sdl_hd_scale_hint(void)
+{
+    int full = 10;                          /* (the pack's own scale is read later; ours are 10x) */
+    int d = display_hd_scale();
+    int base = d > 0 ? d : full;
+    switch (s_set.hd_detail) {
+    case 1: return 0;
+    case 2: { int v = (base * 3 + 2) / 4; return v < 3 ? 3 : v; }
+    case 3: { int v = (base + 1) / 2; return v < 3 ? 3 : v; }
+    default: return d;
+    }
+}
