+/* A game's say in what the background shows (presentation; the machine's
+ * memories are untouched). The hook is asked for every background tile the
+ * PPU fetches while rendering: `line` is the screen line it is for (0-239),
+ * `x` the screen x of its first pixel (it may start left of 0), `v` the PPU
+ * address it came from and `tile` the tile number read. Return -1 to keep it,
+ * or tile | palette << 8 to draw that tile with that palette (0-3) instead.
+ * Games use it to repair what a TV's overscan hid: map rows written late at
+ * the edges of a scrolling screen. NULL removes it. */
+typedef int (*CycBgTileHook)(void *ctx, int line, int x, uint16_t v, uint8_t tile);
+void cyc_ppu_set_bg_tile_hook(CycBgTileHook fn, void *ctx);
+/* Show the background and sprites in the leftmost 8 pixels even where the
+ * game masks them (PPUMASK bits 1-2), e.g. once the hook keeps that column
+ * correct. Presentation only: sprite 0 hits keep the game's own setting. */
+void cyc_ppu_set_show_left(bool on);
+
