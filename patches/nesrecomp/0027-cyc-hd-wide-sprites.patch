+void cyc_render_hd_sprite(int x, int y, uint16_t pattern, int palette, unsigned flags)
+{
+    for (int r = 0; r < 8; ++r) {
+        int py = y + r;
+        if (py < 0 || py >= 240) continue;
+        for (int c = 0; c < 8; ++c) {
+            int px = x + c;
+            if (px < 0 || px >= s_hd_width) continue;
+            HdCell *h = &s_hd_sp[py * s_hd_width + px];
+            h->pattern = pattern; h->pal = (int8_t)((palette & 3) | (flags & 3) << 2); h->oxy = (uint8_t)(c | r << 4);
+        }
+    }
+}
+
+bool cyc_render_hd_sprite_cell(int x, int y, uint16_t *pattern, int *palette, int *ox, int *oy, unsigned *flags)
+{
+    if (x < 0 || y < 0 || x >= s_hd_width || y >= 240) return false;
+    const HdCell *h = &s_hd_sp[y * s_hd_width + x];
+    if (h->pal < 0) return false;
+    *pattern = h->pattern; *palette = h->pal & 3; *flags = (unsigned)(h->pal >> 2) & 3; *ox = h->oxy & 15; *oy = h->oxy >> 4;
+    return true;
+}
+
