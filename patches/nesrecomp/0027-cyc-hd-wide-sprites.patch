+static void add_sprite(HdPixel *p,int x,int y,uint8_t mask,uint32_t drawn) {
+    uint16_t pattern;int pal,ox,oy;unsigned flags;const uint8_t *t;
+    if(!cyc_render_hd_sprite_cell(x,y,&pattern,&pal,&ox,&oy,&flags) || !(t=margin_tile(pattern)))return;
+    int row=(flags&2)?7-oy:oy,col=(flags&1)?7-ox:ox;
+    unsigned v=((t[row]>>(7-col))&1)|(((t[row+8]>>(7-col))&1)<<1);
+    if(!v && !hdpack_sprite_cells())return;
+    p->sp_t16=t;p->sp_index=-1;p->sp_has=1;p->sp_ox=(uint8_t)ox;p->sp_oy=(uint8_t)row;
+    p->sp_hm=(uint8_t)(flags&1);p->sp_vm=(uint8_t)((flags>>1)&1);p->sp_clear=!v;
+    p->sp_p1=cyc_render_palette(16+pal*4+1);p->sp_p2=cyc_render_palette(16+pal*4+2);p->sp_p3=cyc_render_palette(16+pal*4+3);
+    p->sp_argb=v?color(cyc_render_palette(16+pal*4+v),mask):drawn;
+    unsigned k=main_index(t);if(k)p->sp_tint=color(cyc_render_palette(16+pal*4+k),mask);
+}
