From: DragonWarrior4NESRecomp
Subject: [PATCH] cyc: Trim Side Borders display setting (default on)

Many games clear PPUMASK's left-column bits, so the first 8 pixels of
every line are backdrop: a black bar down the left edge. New [Display]
CropSides (default 1) and in-game menu switch "Trim side borders" trim 8
native pixels from both sides of a 256-wide picture (240x240 visible),
keeping it centred; window size, integer scaling and Zapper aiming follow.
Pictures wider than 256 (game compositors) are never trimmed.
---
diff --git a/runner/cyc/cyc_sdl.c b/runner/cyc/cyc_sdl.c
index 68653d9..f688ee9 100644
--- a/runner/cyc/cyc_sdl.c
+++ b/runner/cyc/cyc_sdl.c
@@ -452,6 +452,11 @@ static int s_tex_div = 1;
 static int base_w(void) { return s_tex_w / s_tex_div; }
 static int base_h(void) { return s_tex_h / s_tex_div; }
 static int logical_h(void) { return base_h() + (s_bar ? BAR_ROWS : 0); }
+/* Trim Side Borders: many games clear PPUMASK's left-column bits, so the
+ * first 8 pixels are always backdrop. Trim 8 native pixels from both sides of
+ * a stock-width picture to hide that bar and keep the picture centred. */
+static int crop_px(void) { return s_set.crop_sides && base_w() == 256 ? 8 : 0; }
+static int view_w(void) { return base_w() - 2 * crop_px(); }
 
 static void apply_picture_scale(void)
 {
@@ -461,7 +466,7 @@ static void apply_picture_scale(void)
      * accelerated renderer can produce a black frame with that negative
      * viewport. Fit fractionally until the window is large enough, keeping
      * the player's integer-scaling preference for subsequent enlargement. */
-    SDL_bool integer = s_set.integer_scale && ow >= base_w() && oh >= logical_h()
+    SDL_bool integer = s_set.integer_scale && ow >= view_w() && oh >= logical_h()
                      ? SDL_TRUE : SDL_FALSE;
     if (SDL_RenderGetIntegerScale(s_ren) != integer)
         SDL_RenderSetIntegerScale(s_ren, integer);
@@ -490,7 +495,7 @@ static bool fit_window_to_display(int display, int *w, int *h)
     if (!s_win || SDL_GetWindowBordersSize(s_win, &top, &left, &bottom, &right) != 0) top = 32;
     int max_w = r.w - left - right, max_h = r.h - top - bottom;
     if (*w <= max_w && *h <= max_h) return false;
-    int bw = base_w(), bh = logical_h();
+    int bw = view_w(), bh = logical_h();
     int k = bw > 0 && bh > 0 ? (max_w / bw < max_h / bh ? max_w / bw : max_h / bh) : 1;
     if (k < 1) k = 1;
     *w = bw * k;
@@ -505,7 +510,7 @@ static void apply_settings(void)
     if ((SDL_GetWindowFlags(s_win) & (SDL_WINDOW_FULLSCREEN | SDL_WINDOW_FULLSCREEN_DESKTOP)) != fs)
         SDL_SetWindowFullscreen(s_win, fs);
     if (!fs) {
-        int ww = base_w() * s_set.window_scale, wh = logical_h() * s_set.window_scale;
+        int ww = view_w() * s_set.window_scale, wh = logical_h() * s_set.window_scale;
         int display = SDL_GetWindowDisplayIndex(s_win);
         bool fitted = fit_window_to_display(display, &ww, &wh);
         int cw = 0, ch = 0;
@@ -517,7 +522,7 @@ static void apply_settings(void)
                                       SDL_WINDOWPOS_CENTERED_DISPLAY(display < 0 ? 0 : display));
         }
     }
-    SDL_RenderSetLogicalSize(s_ren, base_w(), logical_h());
+    SDL_RenderSetLogicalSize(s_ren, view_w(), logical_h());
     apply_picture_scale();
     if (s_tex) SDL_SetTextureScaleMode(s_tex, texture_scale_mode());
 }
@@ -531,7 +536,7 @@ static bool ensure_texture(int w, int h)
     s_tex_h = h;
     s_tex_div = picture_divisor(w, h);
     if (s_tex) SDL_SetTextureScaleMode(s_tex, texture_scale_mode());
-    SDL_RenderSetLogicalSize(s_ren, base_w(), logical_h());
+    SDL_RenderSetLogicalSize(s_ren, view_w(), logical_h());
     apply_picture_scale();
     return s_tex != NULL;
 }
@@ -1014,6 +1019,7 @@ static void zapper_window_point(int wx, int wy, int *x, int *y, int *px, int *py
 {
     float lx, ly;
     SDL_RenderWindowToLogical(s_ren, wx, wy, &lx, &ly);
+    lx += (float)crop_px();
     int w, h;
     picture(&w, &h);
     int k = picture_divisor(w, h); w /= k; h /= k;
@@ -1260,15 +1266,17 @@ static void show(bool loading, const char *toast_title, const char *toast_body)
     SDL_UpdateTexture(s_tex, NULL, pic, w * 4);
     SDL_SetRenderDrawColor(s_ren, 0, 0, 0, 255);
     SDL_RenderClear(s_ren);
-    SDL_Rect dst = { 0, 0, w / s_tex_div, h / s_tex_div };
-    SDL_RenderCopy(s_ren, s_tex, NULL, &dst);
+    int crop = crop_px();
+    SDL_Rect src = { crop * s_tex_div, 0, w - 2 * crop * s_tex_div, h };
+    SDL_Rect dst = { 0, 0, w / s_tex_div - 2 * crop, h / s_tex_div };
+    SDL_RenderCopy(s_ren, s_tex, &src, &dst);
     CycZapperState gun;
     cyc_zapper_state(&gun);
     int aim_x = -1, aim_y = -1;
     if (gun.port && !s_zapper_override) aim_x = s_aim_x, aim_y = s_aim_y;
     else if (gun.port && gun.x >= 0) aim_x = gun.x + picture_native_origin(w / s_tex_div), aim_y = gun.y;
     if (gun.port && s_set.zapper_crosshair && aim_x >= 0 && aim_x < w / s_tex_div && !menu_open()) {
-        int x = aim_x, y = aim_y;
+        int x = aim_x - crop, y = aim_y;
         SDL_SetRenderDrawColor(s_ren, 0, 0, 0, 255);
         SDL_Rect back = {x - 5, y - 1, 11, 3}; SDL_RenderFillRect(s_ren, &back);
         back.x = x - 1; back.y = y - 5; back.w = 3; back.h = 11; SDL_RenderFillRect(s_ren, &back);
@@ -1398,7 +1406,7 @@ int cyc_sdl_main(const char *title_in, int scale)
     s_tex_w = w;
     s_tex_h = h;
     s_tex_div = picture_divisor(w, h);
-    int win_w = base_w() * s_set.window_scale, win_h = logical_h() * s_set.window_scale;
+    int win_w = view_w() * s_set.window_scale, win_h = logical_h() * s_set.window_scale;
     fit_window_to_display(0, &win_w, &win_h);
     s_win = SDL_CreateWindow(title, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, win_w, win_h,
                              SDL_WINDOW_RESIZABLE | SDL_WINDOW_ALLOW_HIGHDPI | (s_hidden ? SDL_WINDOW_HIDDEN : 0));
diff --git a/runner/cyc/cyc_settings.c b/runner/cyc/cyc_settings.c
index dd3cdfd..970afb4 100644
--- a/runner/cyc/cyc_settings.c
+++ b/runner/cyc/cyc_settings.c
@@ -18,6 +18,7 @@ void cyc_settings_default(CycSettings *s)
     s->window_scale = 3;
     s->fullscreen = 0;
     s->integer_scale = 1;
+    s->crop_sides = 1;
     s->linear_filter = 0;
     s->vsync = 0;
     s->audio_enabled = 1;
@@ -127,6 +128,7 @@ bool cyc_settings_load(CycSettings *s, const char *path, FILE *log, const CycSet
             if (eq_ci(key, "WindowScale")) bad = !parse_int(val, &v) || (s->window_scale = clampi(v, 1, CYC_WINDOW_SCALE_MAX), 0);
             else if (eq_ci(key, "Fullscreen")) bad = !parse_int(val, &v) || (s->fullscreen = clampi(v, 0, 2), 0);
             else if (eq_ci(key, "IntegerScale")) bad = !parse_int(val, &v) || (s->integer_scale = v != 0, 0);
+            else if (eq_ci(key, "CropSides")) bad = !parse_int(val, &v) || (s->crop_sides = v != 0, 0);
             else if (eq_ci(key, "LinearFilter")) bad = !parse_int(val, &v) || (s->linear_filter = v != 0, 0);
             else if (eq_ci(key, "VSync")) bad = !parse_int(val, &v) || (s->vsync = v != 0, 0);
             else if (eq_ci(key, "HdPackEnabled")) bad = !parse_int(val, &v) || (s->hdpack_enabled = v != 0, 0);
@@ -218,6 +220,7 @@ bool cyc_settings_save(const CycSettings *s, const char *path, const CycSettings
                "# window write this file. Keys are SDL key and controller names.\n");
     fprintf(f, "[Display]\nWindowScale = %d\nFullscreen = %d\nIntegerScale = %d\nLinearFilter = %d\nVSync = %d\n",
             s->window_scale, s->fullscreen, s->integer_scale, s->linear_filter, s->vsync);
+    fprintf(f, "CropSides = %d\n", s->crop_sides);
     fprintf(f,"HdPackEnabled = %d\nHdPackDir = %s\n",s->hdpack_enabled,s->hdpack_dir);
     fprintf(f, "[Audio]\nEnabled = %d\nVolume = %d\n", s->audio_enabled, s->volume);
     fprintf(f, "[Input]\n");
diff --git a/runner/cyc/cyc_settings.h b/runner/cyc/cyc_settings.h
index f74e687..d659f68 100644
--- a/runner/cyc/cyc_settings.h
+++ b/runner/cyc/cyc_settings.h
@@ -40,6 +40,8 @@ typedef struct CycSettings {
     int  window_scale;      /* 1..CYC_WINDOW_SCALE_MAX */
     int  fullscreen;        /* 0 off, 1 borderless, 2 exclusive */
     int  integer_scale;     /* bool */
+    int  crop_sides;        /* bool: trim 8 px from both sides of a 256-wide picture,
+                               hiding the left column many games mask (PPUMASK) */
     int  linear_filter;     /* bool */
     int  vsync;             /* bool: sync presents to the display refresh */
     int  audio_enabled;     /* bool */
diff --git a/runner/cyc/cyc_ui_menu.c b/runner/cyc/cyc_ui_menu.c
index 6abc32a..6324dcc 100644
--- a/runner/cyc/cyc_ui_menu.c
+++ b/runner/cyc/cyc_ui_menu.c
@@ -302,6 +302,7 @@ static int get_value(void *ctx, const RecompRuntimeUiItem *it, int *out)
     if (is_key(it, RECOMP_RUNTIME_UI_KEY_FULLSCREEN)) *out = s->fullscreen;
     else if (is_key(it, RECOMP_RUNTIME_UI_KEY_WINDOW_SCALE)) *out = s->window_scale;
     else if (is_key(it, RECOMP_RUNTIME_UI_KEY_INTEGER_SCALE)) *out = s->integer_scale;
+    else if (is_key(it, "cyc.crop_sides")) *out = s->crop_sides;
     else if (is_key(it, RECOMP_RUNTIME_UI_KEY_LINEAR_FILTER)) *out = s->linear_filter;
     else if (is_key(it, RECOMP_RUNTIME_UI_KEY_AUDIO)) *out = s->audio_enabled;
     else if (is_key(it, RECOMP_RUNTIME_UI_KEY_VOLUME)) *out = s->volume;
@@ -331,6 +332,7 @@ static int set_value(void *ctx, const RecompRuntimeUiItem *it, int v)
     if (is_key(it, RECOMP_RUNTIME_UI_KEY_FULLSCREEN)) s->fullscreen = v < 0 ? 0 : v > 2 ? 2 : v;
     else if (is_key(it, RECOMP_RUNTIME_UI_KEY_WINDOW_SCALE)) s->window_scale = v < 1 ? 1 : v > CYC_WINDOW_SCALE_MAX ? CYC_WINDOW_SCALE_MAX : v;
     else if (is_key(it, RECOMP_RUNTIME_UI_KEY_INTEGER_SCALE)) s->integer_scale = v != 0;
+    else if (is_key(it, "cyc.crop_sides")) s->crop_sides = v != 0;
     else if (is_key(it, RECOMP_RUNTIME_UI_KEY_LINEAR_FILTER)) s->linear_filter = v != 0;
     else if (is_key(it, RECOMP_RUNTIME_UI_KEY_AUDIO)) s->audio_enabled = v != 0;
     else if (is_key(it, RECOMP_RUNTIME_UI_KEY_VOLUME)) s->volume = v < 0 ? 0 : v > 100 ? 100 : v;
@@ -496,6 +498,9 @@ RecompRuntimeUi *cyc_ui_menu_create(const CycUiHost *host)
         /* Game-defined additions follow the host's controls. */
         for (size_t i = 0; i < x->menu_item_count; ++i)
             if (s_item_count < sizeof(s_items) / sizeof(s_items[0])) s_items[s_item_count++] = x->menu_items[i];
+    add("cyc.crop_sides", "Display", "Trim side borders",
+        "Trim 8 pixels from each side: hides the black column many games mask at the left edge and keeps the picture centred.",
+        RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, NULL, 0, NULL);
     add_mod_rows();
     CycZapperState gun;
     cyc_zapper_state(&gun);
