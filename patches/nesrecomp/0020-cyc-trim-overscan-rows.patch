+static int crop_top(void) { return s_set.crop_sides && base_h() == 240 ? 8 : 0; }
+static int crop_bottom(void) { return s_set.crop_sides && base_h() == 240 ? 16 : 0; }
 static int view_w(void) { return base_w() - 2 * crop_px(); }
+static int view_h(void) { return base_h() - crop_top() - crop_bottom(); }
+static int logical_h(void) { return view_h() + (s_bar ? BAR_ROWS : 0); }
 
