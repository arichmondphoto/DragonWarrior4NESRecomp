 }
 
+/* The inverse of gg_decode: the 8-letter code that puts `value` at `addr`
+ * where the cartridge holds `cmp`. */
+inline std::string gg_encode(unsigned a, unsigned v, unsigned c) {
+    static const char L[] = "APZLGITYEOXUKSVN";
+    int n[8];
+    n[0] = (v & 7) | ((v >> 4) & 8);
+    n[1] = ((v >> 4) & 7) | ((a >> 4) & 8);
+    n[2] = ((a >> 4) & 7) | 8;
+    n[3] = ((a >> 12) & 7) | (a & 8);
+    n[4] = (a & 7) | ((a >> 8) & 8);
+    n[5] = ((a >> 8) & 7) | (c & 8);
+    n[6] = (c & 7) | ((c >> 4) & 8);
+    n[7] = ((c >> 4) & 7) | (v & 8);
+    std::string s;
+    for (int i = 0; i < 8; i++) s += L[n[i]];
+    return s;
+}
+
+/* A game's catalog of known codes (GameInfo.cheats_catalog_path), plain text:
+ *   # comment
+ *   [Heading]
+ *   CODE[+CODE...] Name     a ready-made entry; codes that go together joined by +
+ *   slot AAAA BBBB Name     the item picker's "who": first and second free
+ *                           inventory slot (hex CPU addresses, empty = FF there)
+ *   item VV Name            the item picker's "what": item value (hex) and name
+ * An item code is gg_encode(slot address, item value, 0xFF). */
+struct CatalogEntry { std::string section, name; std::vector<std::string> codes; };
+struct CatalogSlot  { unsigned first = 0, second = 0; std::string name; };
+struct CatalogItem  { unsigned value = 0; std::string name; };
+struct Catalog {
+    std::vector<std::string> sections;      /* headings, in file order */
+    std::vector<CatalogEntry> entries;
+    std::vector<CatalogSlot> slots;
+    std::vector<CatalogItem> items;
+};
+
+inline std::string trim(const std::string& s) {
+    size_t a = s.find_first_not_of(" \t\r\n"), b = s.find_last_not_of(" \t\r\n");
+    return a == std::string::npos ? std::string() : s.substr(a, b - a + 1);
+}
+
+/* Parse catalog text; lines that don't fit are skipped. */
+inline Catalog parse_catalog(const std::string& text) {
+    Catalog c;
+    std::string section;
+    size_t pos = 0;
+    while (pos <= text.size()) {
+        size_t nl = text.find('\n', pos);
+        std::string line = trim(text.substr(pos, nl == std::string::npos ? std::string::npos : nl - pos));
+        pos = nl == std::string::npos ? text.size() + 1 : nl + 1;
+        if (line.empty() || line[0] == '#') continue;
+        if (line[0] == '[') {
+            size_t e = line.find(']');
+            if (e != std::string::npos) { section = trim(line.substr(1, e - 1)); c.sections.push_back(section); }
+            continue;
+        }
+        size_t sp = line.find_first_of(" \t");
+        std::string first = line.substr(0, sp), rest = sp == std::string::npos ? "" : trim(line.substr(sp));
+        if (first == "slot" || first == "item") {
+            unsigned a = 0, b = 0;
+            int used = 0;
+            if (first == "slot") {
+                if (std::sscanf(rest.c_str(), "%x %x %n", &a, &b, &used) < 2 || !used) continue;
+                c.slots.push_back({a, b, trim(rest.substr(used))});
+            } else {
+                if (std::sscanf(rest.c_str(), "%x %n", &a, &used) < 1 || !used) continue;
+                c.items.push_back({a, trim(rest.substr(used))});
+            }
+            continue;
+        }
+        CatalogEntry e;
+        e.section = section;
+        e.name = rest;
+        size_t start = 0;
+        bool ok = true;
+        while (ok) {
+            size_t plus = first.find('+', start);
+            std::string code = first.substr(start, plus == std::string::npos ? std::string::npos : plus - start);
+            for (auto& ch : code) ch = (char)std::toupper((unsigned char)ch);
+            unsigned x, y, z; bool h;
+            ok = gg_decode(code, &x, &y, &h, &z);
+            if (ok) e.codes.push_back(code);
+            if (plus == std::string::npos) break;
+            start = plus + 1;
+        }
+        if (ok && !e.codes.empty() && !e.name.empty()) c.entries.push_back(e);
+    }
+    return c;
+}
