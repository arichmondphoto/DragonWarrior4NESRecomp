+/* Add (or turn on, when it is already in the list) each code of an entry. */
+static void cheat_add_codes(const std::vector<std::string>& codes, const std::string& name) {
+    std::string turned_off;
+    for (size_t k = 0; k < codes.size(); k++) {
+        int i = cheat_find(codes[k]);
+        if (i < 0) {
+            std::string nm = codes.size() > 1 ? name + " (" + std::to_string(k + 1) + " of " +
+                                                    std::to_string(codes.size()) + ")" : name;
+            g_cheats.push_back({true, codes[k], nm});
+            i = (int)g_cheats.size() - 1;
+        }
+        g_cheat_status.clear();
+        cheat_turn_on(i);
+        if (!g_cheat_status.empty()) turned_off += " " + g_cheat_status;
+    }
+    g_cheat_status = "Added " + name + "." + turned_off;
+    g_cheat_status_error = false;
+}
+
+/* Are all of an entry's codes in the list and on? */
+static bool cheat_all_on(const std::vector<std::string>& codes) {
+    for (const auto& c : codes) {
+        int i = cheat_find(c);
+        if (i < 0 || !g_cheats[i].on) return false;
+    }
+    return true;
+}
