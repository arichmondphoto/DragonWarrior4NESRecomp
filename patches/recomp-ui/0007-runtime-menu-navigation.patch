+// A pointer resting over the rows must not take the selection back from the
+// keyboard / pad every frame; moving it does take it.
+void resting_pointer_case() {
+    static const RecompRuntimeUiItem items[] = {
+        { "a", "Video", "A", "First.", RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "b", "Video", "B", "A description long enough to wrap onto a second line inside a narrow "
+                             "panel instead of running past its right edge.",
+          RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { "c", "Video", "C", nullptr, RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+    };
+    int value = 0;
+    RecompRuntimeUiConfig config{};
+    config.items = items;
+    config.item_count = 3;
+    config.callbacks.context = &value;
+    config.callbacks.get_value = get_value;
+    config.callbacks.set_value = set_value;
+    RecompRuntimeUi *ui = recomp_runtime_ui_create(&config);
+    recomp_runtime_ui_open(ui);
+    recomp_runtime_ui_enter_section(ui, 0);
+    ImGui::CreateContext();
+    ImGuiIO &io = ImGui::GetIO();
+    io.IniFilename = nullptr;
+    io.DisplaySize = ImVec2(1280, 720);
+    io.DeltaTime = 1.0f / 60.0f;
+    unsigned char *pixels; int width, height;
+    io.Fonts->GetTexDataAsRGBA32(&pixels, &width, &height);
+
+    nested_frame(ui);
+    const ImVec2 c = nested_frame(ui);
+    io.AddMousePosEvent(c.x, c.y);
+    nested_frame(ui);
+    assert(ui->row_index == 2);                 // moved onto C: selects it
+    recomp_runtime_ui_handle_input(ui, RECOMP_RUNTIME_UI_INPUT_UP, 1, 0);
+    nested_frame(ui);
+    nested_frame(ui);
+    assert(ui->row_index == 1);                 // resting pointer leaves B selected
+    io.AddMousePosEvent(c.x + 1.0f, c.y);
+    nested_frame(ui);
+    assert(ui->row_index == 2);                 // moving it takes the row again
+    ImGui::DestroyContext();
+    recomp_runtime_ui_destroy(ui);
+}
