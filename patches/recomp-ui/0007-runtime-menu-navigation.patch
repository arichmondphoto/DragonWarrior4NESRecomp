+// The pointer takes the selection only when it moves (or clicks). A pointer
+// resting over the menu - the middle of the window, where it usually is when
+// the menu opens - would otherwise put the selection back on the row under it
+// every frame, and the arrow keys / D-pad would seem to do nothing.
+// Nor does it count until it has left the spot it was resting on when the menu
+// opened: where it was then is not a choice of row.
+bool pointer_moved(const RecompRuntimeUi *ui) {
+    const ImGuiIO &io = ImGui::GetIO();
+    if (ui->open_frames && !ui->pointer_live) return false;
+    if (!ImGui::IsMousePosValid(&io.MousePos)) return false;
+    if (!ImGui::IsMousePosValid(&io.MousePosPrev)) return true;   // it just came in
+    return io.MousePos.x != io.MousePosPrev.x || io.MousePos.y != io.MousePosPrev.y;
+}
