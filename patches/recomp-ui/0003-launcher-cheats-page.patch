+/* ---- Cheats page (GameInfo.cheats_path) --------------------------------
+ * Game Genie codes kept in a plain text file the host reads at game start:
+ * one per line, "on"/"off", the code, then an optional name. Every change is
+ * written back at once, so there is nothing to apply or lose. */
+struct CheatEntry { bool on; std::string code, name; };
+static std::vector<CheatEntry> g_cheats;
+static std::string g_cheats_path_loaded;
+static char g_cheat_code_buf[16];
+static char g_cheat_name_buf[96];
+static std::string g_cheat_status;
+static bool g_cheat_status_error = false;
+
+static int cheat_gg_letter(char c) {
+    static const char L[] = "APZLGITYEOXUKSVN";
+    const char* p = c ? strchr(L, toupper((unsigned char)c)) : nullptr;
+    return p ? (int)(p - L) : -1;
+}
+
+/* The device's own scrambling: address, value and (8 letters) compare. */
+static bool cheat_gg_decode(const std::string& code, unsigned* addr, unsigned* value,
+                            bool* has_cmp, unsigned* cmp) {
+    if (code.size() != 6 && code.size() != 8) return false;
+    int n[8];
+    for (size_t i = 0; i < code.size(); i++)
+        if ((n[i] = cheat_gg_letter(code[i])) < 0) return false;
+    *addr = 0x8000u | ((n[3] & 7) << 12) | ((n[5] & 7) << 8) | ((n[4] & 8) << 8) |
+            ((n[2] & 7) << 4) | ((n[1] & 8) << 4) | (n[4] & 7) | (n[3] & 8);
+    const int last = code.size() == 8 ? 7 : 5;
+    *value = ((n[1] & 7) << 4) | ((n[0] & 8) << 4) | (n[0] & 7) | (n[last] & 8);
+    *has_cmp = code.size() == 8;
+    *cmp = *has_cmp ? (((n[7] & 7) << 4) | ((n[6] & 8) << 4) | (n[6] & 7) | (n[5] & 8)) : 0;
+    return true;
+}
+
+static void cheats_load(const char* path) {
+    g_cheats.clear();
+    g_cheats_path_loaded = path ? path : "";
+    FILE* f = path ? fopen(path, "r") : nullptr;
+    if (!f) return;
+    char line[512];
+    while (fgets(line, sizeof line, f)) {
+        if (char* h = strchr(line, '#')) *h = 0;
+        char a[32] = "", b[32] = "";
+        int used = 0;
+        if (sscanf(line, "%31s%n", a, &used) < 1) continue;
+        CheatEntry e{true, a, ""};
+        const char* rest = line + used;
+        std::string first = a;
+        for (auto& ch : first) ch = (char)tolower((unsigned char)ch);
+        if (first == "on" || first == "off") {
+            int used2 = 0;
+            if (sscanf(rest, "%31s%n", b, &used2) < 1) continue;
+            e.on = first == "on"; e.code = b; rest += used2;
+        }
+        for (auto& ch : e.code) ch = (char)toupper((unsigned char)ch);
+        while (*rest == ' ' || *rest == '\t') rest++;
+        e.name = rest;
+        while (!e.name.empty() && (e.name.back() == '\n' || e.name.back() == '\r' ||
+                                   e.name.back() == ' ' || e.name.back() == '\t'))
+            e.name.pop_back();
+        g_cheats.push_back(e);
+    }
+    fclose(f);
+}
+
+static bool cheats_save(const char* path) {
+    FILE* f = path ? fopen(path, "w") : nullptr;
+    if (!f) {
+        g_cheat_status = "Could not save the cheats file.";
+        g_cheat_status_error = true;
+        return false;
+    }
+    fputs("# Game Genie codes, edited by the launcher's Cheats page.\n"
+          "# One per line: on/off, the 6- or 8-letter code, then an optional name.\n", f);
+    for (const auto& e : g_cheats)
+        fprintf(f, "%-3s %-8s %s\n", e.on ? "on" : "off", e.code.c_str(), e.name.c_str());
+    fclose(f);
+    return true;
+}
+
+static int cheat_code_filter(ImGuiInputTextCallbackData* d) {
+    return cheat_gg_letter((char)d->EventChar) < 0 ? 1 : 0;   /* only Game Genie letters */
+}
+
+void draw_cheats(LauncherModel* m, const LauncherTheme& th) {
+    if (!m->cheats_path) return;
+    if (g_cheats_path_loaded != m->cheats_path) cheats_load(m->cheats_path);
+    if (!begin_panel("cheats_page", 0, false)) {
+        end_panel();
+        return;
+    }
+    eyebrow("CHEATS");
+    ImGui::PushStyleColor(ImGuiCol_Text, col(th.text_muted));
+    ImGui::PushTextWrapPos();
+    ImGui::TextWrapped("%s", ui_text(
+        "Game Genie codes. Codes that are on apply when the game starts; "
+        "change them here and start the game again. Cheats are never used "
+        "in online play. Some codes can glitch or soft-lock the game, so "
+        "keep a backup of your save."));
+    ImGui::PopTextWrapPos();
+    ImGui::PopStyleColor();
+    ImGui::Dummy(ImVec2(0, px(8)));
+
+    /* add a code */
+    ImGui::PushStyleColor(ImGuiCol_Text, col(th.accent2));
+    ImGui::TextUnformatted(ui_text("ADD A CODE"));
+    ImGui::PopStyleColor();
+    bool submit = false;
+    ImGui::SetNextItemWidth(px(150));
+    if (ImGui::InputTextWithHint("##cheat_code", "Code", g_cheat_code_buf, 9,
+                                 ImGuiInputTextFlags_CharsUppercase |
+                                 ImGuiInputTextFlags_CallbackCharFilter |
+                                 ImGuiInputTextFlags_EnterReturnsTrue,
+                                 cheat_code_filter))
+        submit = true;
+    ImGui::SameLine();
+    ImGui::SetNextItemWidth(px(320));
+    if (ImGui::InputTextWithHint("##cheat_name", "Name (optional)", g_cheat_name_buf,
+                                 sizeof g_cheat_name_buf, ImGuiInputTextFlags_EnterReturnsTrue))
+        submit = true;
+    ImGui::SameLine();
+    if (ImGui::Button(ui_text("Add"), ImVec2(px(90), 0))) submit = true;
+    if (submit) {
+        std::string code = g_cheat_code_buf;
+        unsigned a, v, c; bool hc;
+        if (!cheat_gg_decode(code, &a, &v, &hc, &c)) {
+            g_cheat_status = "A Game Genie code has 6 or 8 letters from A E G I K L N O P S T U V X Y Z.";
+            g_cheat_status_error = true;
+        } else {
+            bool dup = false;
+            for (const auto& e : g_cheats) dup |= e.code == code;
+            if (dup) {
+                g_cheat_status = "That code is already in the list.";
+                g_cheat_status_error = true;
+            } else {
+                g_cheats.push_back({true, code, g_cheat_name_buf});
+                if (cheats_save(m->cheats_path)) {
+                    g_cheat_status = "Added " + code + ".";
+                    g_cheat_status_error = false;
+                }
+                g_cheat_code_buf[0] = 0; g_cheat_name_buf[0] = 0;
+            }
+        }
+    }
+    if (!g_cheat_status.empty())
+        ImGui::TextColored(col(g_cheat_status_error ? th.warn : th.text_muted), "%s",
+                           g_cheat_status.c_str());
+    ImGui::Dummy(ImVec2(0, px(8)));
+
+    /* the list */
+    ImGui::PushStyleColor(ImGuiCol_Text, col(th.accent2));
+    ImGui::TextUnformatted(ui_text("CODES"));
+    ImGui::PopStyleColor();
+    if (g_cheats.empty()) {
+        ImGui::TextColored(col(th.text_muted), "%s", ui_text("No codes yet."));
+    } else if (ImGui::BeginTable("cheats_table", 5,
+                                 ImGuiTableFlags_SizingFixedFit | ImGuiTableFlags_RowBg)) {
+        ImGui::TableSetupColumn("On", ImGuiTableColumnFlags_WidthFixed, px(40));
+        ImGui::TableSetupColumn("Code", ImGuiTableColumnFlags_WidthFixed, px(120));
+        ImGui::TableSetupColumn("Name", ImGuiTableColumnFlags_WidthStretch);
+        ImGui::TableSetupColumn("Patch", ImGuiTableColumnFlags_WidthFixed, px(170));
+        ImGui::TableSetupColumn("", ImGuiTableColumnFlags_WidthFixed, px(90));
+        int remove = -1;
+        bool changed = false;
+        for (int i = 0; i < (int)g_cheats.size(); i++) {
+            CheatEntry& e = g_cheats[i];
+            ImGui::PushID(i);
+            ImGui::TableNextRow();
+            ImGui::TableNextColumn();
+            if (ImGui::Checkbox("##on", &e.on)) changed = true;
+            ImGui::TableNextColumn();
+            ImGui::AlignTextToFramePadding();
+            ImGui::TextUnformatted(e.code.c_str());
+            ImGui::TableNextColumn();
+            ImGui::AlignTextToFramePadding();
+            ImGui::TextUnformatted(e.name.empty() ? "-" : e.name.c_str());
+            ImGui::TableNextColumn();
+            ImGui::AlignTextToFramePadding();
+            unsigned a, v, c; bool hc;
+            if (cheat_gg_decode(e.code, &a, &v, &hc, &c)) {
+                if (hc) ImGui::TextColored(col(th.text_muted), "$%04X = %02X if %02X", a, v, c);
+                else    ImGui::TextColored(col(th.text_muted), "$%04X = %02X", a, v);
+            } else {
+                ImGui::TextColored(col(th.warn), "%s", ui_text("not a code"));
+            }
+            ImGui::TableNextColumn();
+            if (ImGui::Button(ui_text("Delete"), ImVec2(px(84), 0))) remove = i;
+            ImGui::PopID();
+        }
+        ImGui::EndTable();
+        if (remove >= 0) {
+            g_cheat_status = "Deleted " + g_cheats[remove].code + ".";
+            g_cheat_status_error = false;
+            g_cheats.erase(g_cheats.begin() + remove);
+            changed = true;
+        }
+        if (changed) cheats_save(m->cheats_path);
+    }
+    end_panel();
+}
